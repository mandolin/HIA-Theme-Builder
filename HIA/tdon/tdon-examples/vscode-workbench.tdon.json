,\n    \"tab.hoverBackground\": \"{{token:primary.900}}\",\n    \"editorGroup.border\": \"{{token:primary.900}}\",\n    \"editorGroupHeader.tabsBackground\": \"{{token:primary.1000}}\",\n    \"panel.background\": \"{{token:primary.950}}\",\n    \"panel.border\": \"{{token:primary.800}}\",\n    \"panelTitle.activeForeground\": \"{{token:primary.200}}\",\n    \"panelTitle.activeBorder\": \"{{token:primary.400}}\",\n    \"badge.background\": \"{{token:primary.500}}\",\n    \"badge.foreground\": \"{{token:on:primary}}\",\n    \"button.background\": \"{{token:primary.600}}\",\n    \"button.foreground\": \"{{token:on:primary}}\",\n    \"button.hoverBackground\": \"{{token:primary.700}}\",\n    \"input.background\": \"{{token:primary.950}}\",\n    \"input.foreground\": \"{{token:primary.100}}\",\n    \"input.border\": \"{{token:primary.700}}\",\n    \"list.activeSelectionBackground\": \"{{token:primary.800}}\",\n    \"list.activeSelectionForeground\": \"{{token:primary.50}}\",\n    \"list.inactiveSelectionBackground\": \"{{token:primary.900}}\",\n    \"list.hoverBackground\": \"{{token:primary.900}}\",\n    \"list.highlightForeground\": \"{{token:secondary.300}}\",\n    \"notifications.background\": \"{{token:primary.900}}\",\n    \"notifications.foreground\": \"{{token:primary.100}}\",\n    \"notifications.border\": \"{{token:primary.800}}\",\n    \"scrollbarSlider.background\": \"{{token:primary.700}}\",\n    \"menu.background\": \"{{token:primary.1000}}\",\n    \"menu.foreground\": \"{{token:primary.100}}\",\n    \"menu.selectionBackground\": \"{{token:primary.800}}\",\n    \"quickInput.background\": \"{{token:primary.1000}}\",\n    \"quickInput.foreground\": \"{{token:primary.100}}\",\n    \"terminal.background\": \"{{token:primary.1000}}\",\n    \"terminal.foreground\": \"{{token:primary.100}}\",\n    \"terminal.ansiBlack\": \"{{token:primary.1000}}\",\n    \"terminal.ansiRed\": \"{{token:danger.400}}\",\n    \"terminal.ansiGreen\": \"{{token:success.400}}\",\n    \"terminal.ansiYellow\": \"{{token:warning.400}}\",\n    \"terminal.ansiBlue\": \"{{token:primary.400}}\",\n    \"terminal.ansiMagenta\": \"{{token:secondary.400}}\",\n    \"terminal.ansiCyan\": \"{{token:secondary.300}}\",\n    \"terminal.ansiWhite\": \"{{token:primary.200}}\",\n    \"terminal.ansiBrightBlack\": \"{{token:primary.800}}\",\n    \"terminal.ansiBrightRed\": \"{{token:danger.300}}\",\n    \"terminal.ansiBrightGreen\": \"{{token:success.300}}\",\n    \"terminal.ansiBrightYellow\": \"{{token:warning.300}}\",\n    \"terminal.ansiBrightBlue\": \"{{token:primary.300}}\",\n    \"terminal.ansiBrightMagenta\": \"{{token:secondary.300}}\",\n    \"terminal.ansiBrightCyan\": \"{{token:secondary.200}}\",\n    \"terminal.ansiBrightWhite\": \"{{token:primary.50}}\"\n  },\n  \"tokenColors\": [\n    {\n      \"scope\": [\n        \"comment\"\n      ],\n      \"settings\": {\n        \"foreground\": \"{{token:secondary.400}}\",\n        \"fontStyle\": \"italic\"\n      }\n    },\n    {\n      \"scope\": [\n        \"string\",\n        \"string.quoted\"\n      ],\n      \"settings\": {\n        \"foreground\": \"{{token:success.300}}\"\n      }\n    },\n    {\n      \"scope\": [\n        \"constant.numeric\",\n        \"constant.language\"\n      ],\n      \"settings\": {\n        \"foreground\": \"{{token:warning.300}}\"\n      }\n    },\n    {\n      \"scope\": [\n        \"keyword\",\n        \"keyword.control\",\n        \"storage.type\"\n      ],\n      \"settings\": {\n        \"foreground\": \"{{token:primary.300}}\",\n        \"fontStyle\": \"bold\"\n      }\n    },\n    {\n      \"scope\": [\n        \"storage.modifier\"\n      ],\n      \"settings\": {\n        \"foreground\": \"{{token:secondary.300}}\"\n      }\n    },\n    {\n      \"scope\": [\n        \"variable\",\n        \"variable.other\"\n      ],\n      \"settings\": {\n        \"foreground\": \"{{token:primary.100}}\"\n      }\n    },\n    {\n      \"scope\": [\n        \"variable.parameter\"\n      ]