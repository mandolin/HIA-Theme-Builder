{
  "specVersion": "tdon-0.2",
  "target": {
    "id": "vscode-workbench",
    "name": "VS Code workbench 完整版",
    "nameEn": "VS Code Workbench Theme",
    "author": "HIA 官方适配",
    "homepage": "https://code.visualstudio.com/",
    "targetVersion": ">=1.70"
  },
  "tokens": {
    "include": {
      "color": [
        "primary",
        "secondary"
      ],
      "colorShades": "all",
      "gradient": [
        "carousel"
      ],
      "typography": [
        "fontFamily"
      ]
    }
  },
  "preview": {
    "title": "VS Code workbench 预览（亮色全貌）",
    "layout": "sidebar-left",
    "nodes": [
      {
        "type": "tree",
        "bgToken": "primary.50",
        "accentToken": "primary.700",
        "sections": [
          {
            "label": "资源管理器",
            "items": [
              {
                "label": "src",
                "active": false
              },
              {
                "label": "index.ts",
                "active": true
              },
              {
                "label": "theme.ts"
              }
            ]
          },
          {
            "label": "大纲",
            "items": [
              {
                "label": "buildTheme"
              },
              {
                "label": "applyTheme"
              }
            ]
          }
        ]
      },
      {
        "type": "nav",
        "items": [
          {
            "label": "HIA Code",
            "active": true
          },
          "文件",
          "编辑",
          "查看",
          "终端",
          "帮助"
        ],
        "bgToken": "primary.100",
        "activeToken": "primary.800"
      },
      {
        "type": "code-editor",
        "title": "theme.ts",
        "accentToken": "primary.600",
        "code": "import { buildTheme } from \"@hia/theme-core\";\n\n// workbench colors come from HIA tokens\nconst theme = buildTheme({\n  primary: \"#0047AB\",\n  secondary: \"#00A8D3\",\n});\n\nexport function activate() {\n  return theme.primary.scale;\n}"
      },
      {
        "type": "callout",
        "kind": "info",
        "title": "通知横幅",
        "text": "HIA Light / HIA Dark 双主题已就绪：workbench 全局配色 + 语法精简枚举，重载窗口即可切换。"
      },
      {
        "type": "nav",
        "items": [
          "main ⌥",
          "Ln 7, Col 24",
          "UTF-8",
          "TypeScript"
        ],
        "bgToken": "primary.600",
        "activeToken": "on:primary"
      },
      {
        "type": "divider",
        "token": "primary.100",
        "thickness": 1
      },
      {
        "type": "raw-text",
        "text": "状态栏以 nav 节点模拟（primary.600 底 + 可读前景）；侧栏树/编辑器/通知为真实节点形态。",
        "textToken": "primary.500",
        "size": "fs:small"
      }
    ]
  },
  "exportManifest": {
    "files": [
      {
        "path": "hia-vscode-extension/package.json",
        "template": "{\n  \"name\": \"hia-theme\",\n  \"displayName\": \"{{meta:name}} for VS Code\",\n  \"description\": \"HIA Theme Builder generated VS Code theme: full workbench colors + syntax token colors (light & dark).\",\n  \"publisher\": \"hia-theme-builder\",\n  \"version\": \"1.0.0\",\n  \"license\": \"MIT\",\n  \"engines\": {\n    \"vscode\": \"^1.70.0\"\n  },\n  \"categories\": [\n    \"Themes\"\n  ],\n  \"contributes\": {\n    \"themes\": [\n      {\n        \"label\": \"HIA Light\",\n        \"path\": \"./themes/hia-light-color-theme.json\",\n        \"uiTheme\": \"vs\"\n      },\n      {\n        \"label\": \"HIA Dark\",\n        \"path\": \"./themes/hia-dark-color-theme.json\",\n        \"uiTheme\": \"vs-dark\"\n      }\n    ]\n  }\n}"
      },
      {
        "path": "hia-vscode-extension/themes/hia-light-color-theme.json",
        "template": "{\n  \"name\": \"{{meta:name}} Light\",\n  \"type\": \"vs\",\n  \"colors\": {\n    \"editor.background\": \"{{token:primary.50}}\",\n    \"editor.foreground\": \"{{token:primary.900}}\",\n    \"editorLineNumber.foreground\": \"{{token:primary.400}}\",\n    \"editorLineNumber.activeForeground\": \"{{token:primary.700}}\",\n    \"editorCursor.foreground\": \"{{token:primary.700}}\",\n    \"editor.lineHighlightBackground\": \"{{token:primary.100}}\",\n    \"editor.selectionBackground\": \"{{token:primary.200}}\",\n    \"editor.selectionHighlightBackground\": \"{{token:primary.100}}\",\n    \"editorIndentGuide.background\": \"{{token:primary.200}}\",\n    \"activityBar.background\": \"{{token:primary.100}}\",\n    \"activityBar.foreground\": \"{{token:primary.800}}\",\n    \"activityBar.inactiveForeground\": \"{{token:primary.500}}\",\n    \"activityBar.activeBorder\": \"{{token:primary.700}}\",\n    \"activityBarBadge.background\": \"{{token:primary.600}}\",\n    \"activityBarBadge.foreground\": \"{{token:on:primary}}\",\n    \"sideBar.background\": \"{{token:primary.50}}\",\n    \"sideBar.foreground\": \"{{token:primary.900}}\",\n    \"sideBarSectionHeader.background\": \"{{token:primary.100}}\",\n    \"sideBarSectionHeader.foreground\": \"{{token:primary.800}}\",\n    \"titleBar.activeBackground\": \"{{token:primary.600}}\",\n    \"titleBar.activeForeground\": \"{{token:on:primary}}\",\n    \"titleBar.border\": \"{{token:primary.200}}\",\n    \"statusBar.background\": \"{{token:primary.600}}\",\n    \"statusBar.foreground\": \"{{token:on:primary}}\",\n    \"statusBar.border\": \"{{token:primary.200}}\",\n    \"tab.activeBackground\": \"{{token:primary.50}}\",\n    \"tab.activeForeground\": \"{{token:primary.900}}\",\n    \"tab.inactiveBackground\": \"{{token:primary.100}}\",\n    \"tab.inactiveForeground\": \"{{token:primary.600}}\",\n    \"tab.activeBorderTop\": \"{{token:primary.700}}\",\n    \"tab.border\": \"{{token:primary.200}}\",\n    \"tab.hoverBackground\": \"{{token:primary.100}}\",\n    \"editorGroup.border\": \"{{token:primary.200}}\",\n    \"editorGroupHeader.tabsBackground\": \"{{token:primary.100}}\",\n    \"panel.background\": \"{{token:primary.50}}\",\n    \"panel.border\": \"{{token:primary.200}}\",\n    \"panelTitle.activeForeground\": \"{{token:primary.800}}\",\n    \"panelTitle.activeBorder\": \"{{token:primary.600}}\",\n    \"badge.background\": \"{{token:primary.600}}\",\n    \"badge.foreground\": \"{{token:on:primary}}\",\n    \"button.background\": \"{{token:primary.600}}\",\n    \"button.foreground\": \"{{token:on:primary}}\",\n    \"button.hoverBackground\": \"{{token:primary.700}}\",\n    \"input.background\": \"{{token:primary.50}}\",\n    \"input.foreground\": \"{{token:primary.900}}\",\n    \"input.border\": \"{{token:primary.200}}\",\n    \"list.activeSelectionBackground\": \"{{token:primary.100}}\",\n    \"list.activeSelectionForeground\": \"{{token:primary.900}}\",\n    \"list.inactiveSelectionBackground\": \"{{token:primary.50}}\",\n    \"list.hoverBackground\": \"{{token:primary.100}}\",\n    \"list.highlightForeground\": \"{{token:secondary.600}}\",\n    \"notifications.background\": \"{{token:primary.50}}\",\n    \"notifications.foreground\": \"{{token:primary.900}}\",\n    \"notifications.border\": \"{{token:primary.200}}\",\n    \"scrollbarSlider.background\": \"{{token:primary.300}}\",\n    \"menu.background\": \"{{token:primary.50}}\",\n    \"menu.foreground\": \"{{token:primary.900}}\",\n    \"menu.selectionBackground\": \"{{token:primary.100}}\",\n    \"quickInput.background\": \"{{token:primary.50}}\",\n    \"quickInput.foreground\": \"{{token:primary.900}}\",\n    \"terminal.background\": \"{{token:primary.950}}\",\n    \"terminal.foreground\": \"{{token:primary.100}}\",\n    \"terminal.ansiBlack\": \"{{token:primary.900}}\",\n    \"terminal.ansiRed\": \"{{token:danger.500}}\",\n    \"terminal.ansiGreen\": \"{{token:success.500}}\",\n    \"terminal.ansiYellow\":