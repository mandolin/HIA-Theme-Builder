{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:front",
    "devPath": "dist",
    "distDir": "dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "HIA Theme Builder",
    "version": "0.3.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true },
      "dialog": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": ["msi"],
      "identifier": "com.hia.theme-builder",
      "icon": ["icons/icon.ico"],
      "windows": {
        "certificateThumbprint": "E68466AD564223C2B5E9FEA02BBE9166D9A39DA6"
      }
    },
    "windows": [
      {
        "title": "HIA 主题构建器 · Tauri",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data:"
    }
  }
}
