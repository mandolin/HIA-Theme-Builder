{
  "name": "@hia/theme-core",
  "version": "0.6.0",
  "description": "HIA cross-platform theme domain core: models, OKLCH algorithms, theme studio state, gradient rendering, token export and website-color analysis.",
  "license": "MIT",
  "author": "HIA Theme Builder contributors",
  "homepage": "https://mandolin.github.io/HIA-Theme-Builder/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/HIA-Theme-Builder.git",
    "directory": "HIA/core"
  },
  "bugs": {
    "url": "https://github.com/mandolin/HIA-Theme-Builder/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "npm run build && node --test",
    "test:watch": "node --test --watch",
    "prepublishOnly": "npm run clean && npm run build && node --test"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "theme",
    "design-token",
    "design-system",
    "oklch",
    "color",
    "css-variables",
    "hia"
  ]
}
