{
  "name": "@hia/theme-core",
  "version": "0.1.0",
  "description": "HIA-Theme-Builder public core: theme model, OKLCH color algorithm, secondary-color harmony, token (CSS/JSON) export. Framework-agnostic, DOM-free.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "theme",
    "design-token",
    "oklch",
    "color",
    "hia"
  ]
}
