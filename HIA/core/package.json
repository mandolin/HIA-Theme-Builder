{
  "name": "@hia/theme-core",
  "version": "0.4.0",
  "description": "HIA cross-platform theme domain core: models, OKLCH algorithms, theme studio state, gradient rendering, token export and website-color analysis.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "tdon-examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "npm run build && node --test test/",
    "test:watch": "node --test --watch test/"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "theme",
    "design-token",
    "oklch",
    "color",
    "hia"
  ]
}
