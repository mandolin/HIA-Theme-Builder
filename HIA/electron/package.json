{
  "name": "@hia/theme-electron",
  "version": "0.4.0",
  "description": "HIA-Theme-Builder desktop (Electron): theme console plus URL color extraction with SSRF-safe fetching. License Apache-2.0.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mandolin/HIA-Theme-Builder.git"
  },
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-preload-cjs.js && node scripts/copy-renderer.js",
    "start": "npm run build && electron dist/main.js",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win portable nsis"
  },
  "dependencies": {
    "@hia/theme-core": "file:../core",
    "@hia/theme-url-extractor": "file:../extractor"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.hia.theme-builder.electron",
    "productName": "HIA Theme Builder",
    "copyright": "Copyright © 2026 HIA. Apache-2.0.",
    "files": [
      "dist/**/*",
      "node_modules/@hia/theme-core/dist/**/*",
      "node_modules/@hia/theme-url-extractor/dist/**/*",
      "node_modules/@hia/theme-core/package.json",
      "node_modules/@hia/theme-url-extractor/package.json"
    ],
    "portable": {
      "artifactName": "HIA-Theme-Builder-Electron-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "HIA-Theme-Builder-Electron-${version}-setup.exe"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "resources/icon.png",
      "publisherName": "HIA",
      "signtoolOptions": {
        "certificateFile": "../../certs/hia-theme-builder.pfx",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    }
  }
}
